APP_NAME=excel-workspace-backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8090
APP_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Leave empty for project-relative defaults under ../storage.
# Relative override values are resolved from the project root; absolute values
# are only needed for deliberate external volumes.
EXCEL_DATABASE_PATH=
EXCEL_STORAGE_ROOT=
EXCEL_PREVIEW_MAX_ROWS=500
EXCEL_MAX_UPLOAD_BYTES=52428800
EXCEL_ARCHIVE_RETENTION_DAYS=30

# Upload parsing runs through a durable task table plus an in-process worker.
UPLOAD_TASK_WORKER_ENABLED=true
UPLOAD_TASK_WORKER_POLL_INTERVAL_SECONDS=0.5
UPLOAD_TASK_STALE_PROCESSING_MINUTES=60
PDF_UPLOAD_TASK_WORKER_ENABLED=true
PDF_UPLOAD_TASK_WORKER_POLL_INTERVAL_SECONDS=0.5
PDF_UPLOAD_TASK_STALE_PROCESSING_MINUTES=60

# PDF vector projections and online ranking use separate release switches.
# Enable indexing first, complete backfill and quality checks, then enable ranking.
# PDF_VECTOR_SEARCH_ENABLED is a deprecated compatibility switch; leave it unset.
PDF_VECTOR_INDEXING_ENABLED=false
PDF_VECTOR_RANKING_ENABLED=false
PDF_VECTOR_WORKER_POLL_INTERVAL_SECONDS=1
PDF_VECTOR_WORKER_LEASE_SECONDS=900
PDF_VECTOR_WORKER_MAX_ATTEMPTS=20
PDF_VECTOR_WORKER_RETRY_MAX_SECONDS=900
PDF_VECTOR_RECONCILIATION_INTERVAL_SECONDS=60
PDF_VECTOR_RECONCILIATION_BATCH_SIZE=100
PDF_ANSWER_MAX_CONTEXT_CHUNKS=160
PDF_ANSWER_MAX_CONTEXT_CHARACTERS=120000
PDF_ANSWER_MAX_CONTEXT_TOKENS=30000
# Empty endpoint/key values inherit the existing SiliconFlow LLM connection below.
PDF_EMBEDDING_API_BASE_URL=
PDF_EMBEDDING_API_KEY=
PDF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Contract identity: bump whenever model, dimensions, instructions, or preprocessing change.
PDF_EMBEDDING_REVISION=siliconflow-qwen3-embedding-8b-d4096-query-v1-doc-v1
PDF_EMBEDDING_DIMENSION=4096
PDF_EMBEDDING_BATCH_SIZE=16
PDF_DOCUMENT_CHUNK_MAX_CHARACTERS=12000
PDF_EMBEDDING_TIMEOUT_SECONDS=120
PDF_RERANKER_API_BASE_URL=
PDF_RERANKER_API_KEY=
PDF_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
PDF_RERANKER_REVISION=siliconflow-qwen3-reranker-8b-v1
PDF_RERANKER_TIMEOUT_SECONDS=120
PDF_RERANKER_BATCH_SIZE=16
PDF_RERANKER_MAX_DOCUMENT_CHARACTERS=24000
PDF_RERANKER_MAX_BATCH_CHARACTERS=120000
PDF_QDRANT_API_BASE_URL=http://127.0.0.1:6333
PDF_QDRANT_API_KEY=
PDF_QDRANT_COLLECTION=pdf_chunks_qwen3_4096_v1
PDF_QDRANT_TIMEOUT_SECONDS=30
# Development may bootstrap automatically. Production startup requires false and an
# explicit preflight invocation with --bootstrap-qdrant during deployment.
PDF_QDRANT_AUTO_BOOTSTRAP=true

# PDF parser runtime. Use fake for tests, mineru for real PDF extraction.
PDF_PARSER_BACKEND=fake
# If MinerU lives in a separate virtual environment, set its absolute executable path.
MINERU_COMMAND=mineru
# The first pipeline run may download or initialize models.
MINERU_TIMEOUT_SECONDS=1200
# pipeline is the conservative CPU-friendly MinerU backend. Leave empty to let MinerU choose.
MINERU_CLI_BACKEND=pipeline
# Optional comma-separated CLI flags, for example: --lang,ch
MINERU_EXTRA_ARGS=
# MinerU official v4 cloud parsing. Store real secrets only in backend/.env,
# never in committed files. The v4 API uses a Bearer API Token created in
# MinerU API Management; Access Key/Secret Key are kept as placeholders for
# compatibility notes but are not sent by the adapter.
MINERU_CLOUD_API_BASE_URL=https://mineru.net/api/v4
MINERU_CLOUD_API_TOKEN=
MINERU_CLOUD_ACCESS_KEY=
MINERU_CLOUD_SECRET_KEY=
MINERU_CLOUD_MODEL_VERSION=vlm
MINERU_CLOUD_TIMEOUT_SECONDS=1200
MINERU_CLOUD_POLL_INTERVAL_SECONDS=5
MINERU_CLOUD_LANGUAGE=ch
MINERU_CLOUD_ENABLE_FORMULA=true
MINERU_CLOUD_ENABLE_TABLE=true
MINERU_CLOUD_IS_OCR=false

# Shared cancellation state lets multi-worker deployments stop chat requests across processes.
CHAT_CANCELLATION_RETENTION_SECONDS=300

# Set to "fake" for local tests without network calls. Runtime default is siliconflow.
LLM_PROVIDER=siliconflow

# SiliconFlow provider credentials. These are used when a stage provider is "siliconflow".
LLM_API_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_SUMMARY_PROVIDER=deepseek
LLM_SUMMARY_MODEL=deepseek-v4-pro
LLM_ROUTER_PROVIDER=siliconflow
LLM_ROUTER_MODEL=Qwen/Qwen3.6-35B-A3B
LLM_ANSWER_PROVIDER=deepseek
LLM_ANSWER_MODEL=deepseek-v4-pro

# DeepSeek Official provider credentials. These are used when a stage provider is "deepseek".
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-pro
DEEPSEEK_ROUTER_MODEL=deepseek-v4-flash
DEEPSEEK_ANSWER_MODEL=deepseek-v4-pro

# Volcano Ark provider credentials. These are used when a stage provider is "volcengine_ark".
VOLCENGINE_ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_SUMMARY_MODEL=doubao-seed-2-0-pro-260215
VOLCENGINE_ARK_ROUTER_MODEL=doubao-seed-2-0-lite-260428
VOLCENGINE_ARK_ANSWER_MODEL=deepseek-v4-pro-260425
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_SUMMARY_MAX_PROFILE_ROWS=10
PDF_ROUTING_MAX_REQUEST_CHARACTERS=120000
PDF_ROUTING_MAX_BATCH_DOCUMENTS=20
LLM_ANSWER_MAX_ROWS=20000

# Long-running maintenance.
MAINTENANCE_INTERVAL_SECONDS=300
MAINTENANCE_AUTH_SESSION_RETENTION_DAYS=30
MAINTENANCE_PASSWORD_RESET_TOKEN_RETENTION_DAYS=7

# Authentication. The built-in administrator is fixed in application code as
# admin@qq.com / admin and cannot be overridden through environment variables.
AUTH_SESSION_TTL_HOURS=336
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_PASSWORD_HASH_ITERATIONS=260000
# Development can expose reset tokens directly. Production must set this to false.
AUTH_EXPOSE_RESET_TOKEN=true
AUTH_LOGIN_RATE_LIMIT_MAX_FAILURES=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_COOKIE_NAME=excelai_session
AUTH_CSRF_COOKIE_NAME=excelai_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Rotating application logs. Leave LOG_FILE_PATH empty to use storage/logs/backend.log.
# Relative override values are resolved from the project root.
LOG_LEVEL=INFO
LOG_FILE_PATH=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Readiness disk-space thresholds. Warning produces a degraded 200 response;
# critical produces a not-ready 503 response.
READINESS_DISK_WARNING_FREE_BYTES=2147483648
READINESS_DISK_CRITICAL_FREE_BYTES=536870912
READINESS_DISK_WARNING_FREE_PERCENT=10
READINESS_DISK_CRITICAL_FREE_PERCENT=3
